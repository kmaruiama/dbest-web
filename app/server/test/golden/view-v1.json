    "captions": {
        "1": {
            "engineClass": "IndexScan",
            "expression": "users",
            "alias": "u"
        },
        "2": {
            "engineClass": "IndexScan",
            "expression": "orders",
            "alias": "o"
        },
        "3": {
            "engineClass": "HashLeftJoin",
            "expression": "u.id = o.user_id",
            "alias": null
        },
        "4": {
            "engineClass": "Filter",
            "expression": "o.total ≥ 100 AND (u.active = true OR u.nick IS NULL) AND u.name IS NOT NULL AND u.id ≠ o.user_id AND u.score > 1.5 AND u.ratio < 0.9 AND u.visits ≤ 100 AND u.name = 'Ana'",
            "alias": null
        },
        "5": {
            "engineClass": "Projection",
            "expression": "u.name, o.total",
            "alias": null
        },
        "6": {
