            "expression": "u.tags",
            "alias": null
        },
        "12": {
            "engineClass": "AutoIncrement",
            "expression": "row from 5",
            "alias": "r"
        },
        "13": {
            "engineClass": "HashAggregation",
            "expression": "o.user_id: sum(total), count(id), max(total), min(total), avg(total), first(id), last(id), count_all(id), count_null(id)",
            "alias": "byUser"
        },
        "14": {
