{
    "session": {
        "tables": {
            "1": {
                "@type": "memory",
                "name": "users",
                "columns": [
                    {
                        "name": "id",
                        "type": "INT",
                        "primaryKey": true,
                        "nullable": false
                    },
                    {
                        "name": "name",
                        "type": "STRING",
                        "primaryKey": false,
                        "nullable": false
                    },
                    {
                        "name": "visits",
                        "type": "LONG",
                        "primaryKey": false,
                        "nullable": false
                    },
                    {
                        "name": "score",
                        "type": "FLOAT",
                        "primaryKey": false,
                        "nullable": false
                    },
                    {
                        "name": "ratio",
                        "type": "DOUBLE",
                        "primaryKey": false,
                        "nullable": false
                    },
                    {
                        "name": "active",
                        "type": "BOOLEAN",
                        "primaryKey": false,
                        "nullable": false
                    },
                    {
                        "name": "nick",
                        "type": "STRING",
                        "primaryKey": false,
                        "nullable": true
                    }
                ],
                "rows": [
                    {
                        "id": {
                            "int": 1
                        },
                        "name": {
                            "str": "Ana"
                        },
                        "visits": {
                            "long": 10
                        },
                        "score": {
                            "float": 1.5
                        },
                        "ratio": {
                            "double": 0.25
                        },
                        "active": {
                            "bool": true
                        },
                        "nick": null
                    },
                    {
                        "id": {
                            "int": 2
                        },
                        "name": {
                            "str": "Bruno"
                        },
                        "visits": {
                            "long": 3
                        },
                        "score": {
                            "float": 2.5
                        },
                        "ratio": {
                            "double": 0.5
                        },
                        "active": {
                            "bool": false
                        },
                        "nick": {
                            "str": "bru"
                        }
                    }
                ]
            },
            "2": {
                "@type": "csv",
                "name": "orders",
                "path": "data/orders.csv",
                "columns": [
                    {
                        "name": "id",
                        "type": "INT",
                        "primaryKey": true,
                        "nullable": false
                    },
                    {
                        "name": "user_id",
                        "type": "INT",
                        "primaryKey": false,
                        "nullable": false
                    },
                    {
                        "name": "total",
                        "type": "INT",
                        "primaryKey": false,
                        "nullable": false
                    }
                ],
                "separator": ";",
                "delimiter": "'",
                "headerLine": 2
            },
            "3": {
                "@type": "btree",
                "name": "archive",
                "path": "data/archive.btree",
                "cacheSize": 512
            }
        },
        "nodes": {
            "1": {
                "@type": "table",
                "table": 1,
                "alias": "u"
            },
            "2": {
                "@type": "table",
                "table": 2,
                "alias": "o"
            },
            "3": {
                "@type": "join",
                "on": [
                    {
                        "left": {
                            "source": "u",
                            "column": "id"
                        },
                        "right": {
                            "source": "o",
                            "column": "user_id"
                        }
                    }
                ],
                "type": "LEFT",
                "algorithm": "HASH"
            },
            "4": {
                "@type": "filter",
                "condition": {
                    "@type": "and",
                    "conditions": [
                        {
                            "@type": "cmp",
                            "left": {
                                "source": "o",
                                "name": "total"
                            },
                            "op": "GTE",
                            "right": {
                                "int": 100
                            }
                        },
                        {
                            "@type": "or",
                            "conditions": [
                                {
                                    "@type": "cmp",
                                    "left": {
                                        "source": "u",
                                        "name": "active"
                                    },
                                    "op": "EQ",
                                    "right": {
                                        "bool": true
                                    }
                                },
                                {
                                    "@type": "isNull",
                                    "column": {
                                        "source": "u",
                                        "name": "nick"
                                    }
                                }
                            ]
                        },
                        {
                            "@type": "isNotNull",
                            "column": {
                                "source": "u",
                                "name": "name"
                            }
                        },
                        {
                            "@type": "cmp",
                            "left": {
                                "source": "u",
                                "name": "id"
                            },
                            "op": "NEQ",
                            "right": {
                                "ref": "o.user_id"
                            }
                        },
                        {
                            "@type": "cmp",
                            "left": {
                                "source": "u",
                                "name": "score"
                            },
                            "op": "GT",
                            "right": {
                                "float": 1.5
                            }
                        },
                        {
                            "@type": "cmp",
                            "left": {
                                "source": "u",
                                "name": "ratio"
                            },
                            "op": "LT",
                            "right": {
                                "double": 0.9
                            }
                        },
                        {
                            "@type": "cmp",
                            "left": {
                                "source": "u",
                                "name": "visits"
                            },
                            "op": "LTE",
                            "right": {
                                "long": 100
                            }
                        },
                        {
                            "@type": "cmp",
                            "left": {
                                "source": "u",
                                "name": "name"
                            },
                            "op": "EQ",
                            "right": {
                                "str": "Ana"
                            }
                        }
                    ]
                }
            },
            "5": {
                "@type": "project",
                "columns": [
                    "u.name",
                    "o.total"
                ]
            },
            "6": {
                "@type": "sort",
                "keys": [
                    {
                        "column": "u.name",
                        "ascending": true
                    },
                    {
                        "column": "o.total",
                        "ascending": true
                    }
                ]
            },
            "7": {
                "@type": "distinct",
                "hashed": false
            },
            "8": {
                "@type": "limit",
                "count": 20,
                "offset": 0
            },
            "9": {
                "@type": "alias",
                "from": "u",
                "to": "people"
            },
            "10": {
                "@type": "collapse",
                "alias": "all"
            },
            "11": {
                "@type": "explode",
                "column": "u.tags",
                "delimiter": ";"
            },
            "12": {
                "@type": "rowNumber",
                "alias": "r",
                "column": "row",
                "start": 5
            },
            "13": {
                "@type": "agg",
                "alias": "byUser",
                "by": {
                    "source": "o",
                    "column": "user_id"
                },
                "aggregates": [
                    {
                        "column": "total",
                        "function": "SUM"
                    },
                    {
                        "column": "id",
                        "function": "COUNT"
                    },
                    {
                        "column": "total",
                        "function": "MAX"
                    },
                    {
                        "column": "total",
                        "function": "MIN"
                    },
                    {
                        "column": "total",
                        "function": "AVG"
                    },
                    {
                        "column": "id",
                        "function": "FIRST"
                    },
                    {
                        "column": "id",
                        "function": "LAST"
                    },
                    {
                        "column": "id",
                        "function": "COUNT_ALL"
                    },
                    {
                        "column": "id",
                        "function": "COUNT_NULL"
                    }
                ],
                "hashed": true
            },
            "14": {
                "@type": "agg",
                "alias": "overall",
                "by": null,
                "aggregates": [
                    {
                        "column": "total",
                        "function": "SUM"
                    }
                ],
                "hashed": true
            },
            "15": {
                "@type": "materialize"
            },
            "16": {
                "@type": "memoize"
            },
            "17": {
                "@type": "hashIndex"
            },
            "18": {
                "@type": "cross"
            },
            "19": {
                "@type": "setOp",
                "kind": "UNION",
                "hashed": false
            },
            "21": {
                "@type": "distinct",
                "hashed": true
            },
            "20": {
                "@type": "setOp",
                "kind": "APPEND",
                "hashed": true
            }
        },
        "edges": [
